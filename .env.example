# ---- Core ----
# development | production. Production disables the anonymous dev read fallback.
ENV=development
APP_BASE_URL=http://localhost:8000
CONSOLE_URL=http://localhost:5173

# ---- Postgres ----
POSTGRES_USER=triagehub
POSTGRES_PASSWORD=triagehub
POSTGRES_DB=triagehub
# Used by the backend when run on the host.
DATABASE_URL=postgresql+psycopg://triagehub:triagehub@localhost:5432/triagehub

# ---- Sessions / signing ----
# Rotate both in any real deployment. SESSION_SECRET signs session cookies.
SESSION_SECRET=change-me-session-secret
SESSION_COOKIE_NAME=triagehub_session
SESSION_TTL_SECONDS=43200
STATE_SECRET=change-me-state-secret
STATE_TTL_SECONDS=600

# ---- Token encryption ----
# urlsafe base64-encoded 32-byte Fernet key. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ---- Slack app ----
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=http://localhost:8000/api/oauth/slack/callback
# Comma-separated bot scopes requested during install.
SLACK_SCOPES=commands,chat:write,users:read
SLACK_BOT_TOKEN=
SLACK_AUTHORIZE_URL=https://slack.com/oauth/v2/authorize
SLACK_TOKEN_URL=https://slack.com/api/oauth.v2.access
SLACK_API_BASE=https://slack.com/api

# ---- GitHub App ----
GITHUB_APP_ID=0
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/oauth/github/callback
GITHUB_WEBHOOK_SECRET=
# PEM contents with \n escapes, or leave empty for the fake-only test path.
GITHUB_PRIVATE_KEY=
GITHUB_API_BASE=https://api.github.com
GITHUB_AUTHORIZE_URL=https://github.com/login/oauth/authorize
GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token

# ---- OIDC identity provider (SSO) ----
OIDC_ISSUER=https://idp.example.com
OIDC_CLIENT_ID=triagehub
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/api/auth/sso/callback
OIDC_AUTHORIZE_URL=https://idp.example.com/oauth2/authorize
OIDC_TOKEN_URL=https://idp.example.com/oauth2/token
OIDC_JWKS_URL=https://idp.example.com/.well-known/jwks.json
OIDC_SCOPES=openid email profile
